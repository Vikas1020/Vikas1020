doctype html
html
  head
    title Node MySQL App
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    style.
      body {
        font-family: Arial, sans-serif;
        background: #0f172a;
        color: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
      }
      .card {
        background: #020617;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0,0,0,0.6);
        text-align: center;
        width: 400px;
      }
      h1 { color: #38bdf8; }
      p { color: #cbd5e1; }

  body
    .card
      h1 Node.js + MySQL
      p App is running successfully 🚀
      p Server Port: #{port}

